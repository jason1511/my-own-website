# HTML should never remain stale after a deployment. CSS and JavaScript may be
# stored locally, but browsers must validate them against Cloudflare before use.
/
  Cache-Control: no-store

/*.html
  Cache-Control: no-store

/admin
  Cache-Control: no-store

/css/*
  Cache-Control: no-cache, must-revalidate

/js/*
  Cache-Control: no-cache, must-revalidate
